{
  "name": "oxc-angular-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.22.3 || ^24.15.0 || >=26.0.0" },
  "scripts": {
    "start": "npm run dev:oxc",
    "benchmark": "npm run compare && node scripts/benchmark.mjs",
    "compare": "node scripts/compare.mjs",
    "dev:oxc": "npm run compare && vite --port 5173",
    "dev:angular": "npm run compare && ng serve --port 4200",
    "build": "npm run compare && ng build && vite build",
    "build:angular": "npm run compare && ng build",
    "build:oxc": "npm run compare && vite build"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@oxc-angular/vite": "0.0.45",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
